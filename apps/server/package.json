{
  "name": "@starhold/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js --external:express --external:socket.io --external:helmet --external:zod",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.src-only.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@starhold/bots": "*",
    "@starhold/engine": "*",
    "@starhold/protocol": "*",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "socket.io": "^4.8.4",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.0.0",
    "socket.io-client": "^4.8.4"
  }
}
