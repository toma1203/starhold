{
  "name": "starhold",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Online space strategy board game: build, trade, conquer.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toma1203/starhold.git"
  },
  "workspaces": [
    "packages/*",
    "themes/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build": "npm run build -w @starhold/web && npm run build -w @starhold/server",
    "e2e": "playwright test -c apps/web/test/e2e/playwright.config.ts",
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @starhold/server\" \"npm run dev -w @starhold/web\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.48.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "fast-check": "^3.23.2",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
